module(
    name = "hdlf_rules_em",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# This module's helpers (the launcher, the stub and checker of swap_test,
# the comparer of determinism_test) and its development tools are Go,
# built from source. They are pure Go, so a user of the module needs no
# C++ toolchain for them; rules_go brings its own Go SDK.
bazel_dep(name = "rules_go", version = "0.64.2")

# The helpers toolchain, which every rule that runs a tool needs.
# openEMS's Python bindings run on rules_python's hermetic CPython 3.12,
# with wheels locked with their hashes in requirements_lock.txt (`bazel run
# //tools:requirements.update` writes it from requirements.in). The CSXCAD
# and openEMS wheels are built once and mirrored as release assets
# (tools/openems_wheels, tools/mirror); the rest come from PyPI. pip.parse
# takes binary wheels only.
bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Registers the 3.12 interpreter. Not the default: that is the root
    # module's choice. The runner picks 3.12 by its python_version.
    is_default = False,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    hub_name = "em_pip",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "em_pip")

register_toolchains(
    "//em/toolchains:helpers",
    # Last, so it is picked only off Linux x86_64 (spec P1).
    "//em/toolchains:unsupported",
)

# The demonstration tools of the swap test template
# (em/private/swapdemo) and of determinism_test's own tests
# (em/private/detdemo).
register_toolchains(
    "//em/private/swapdemo:all",
    "//em/private/detdemo:all",
    dev_dependency = True,
)

# stardoc renders through Java and protobuf. Protobuf 34.1 and later bring a
# prebuilt protoc (enabled in .bazelrc), so the documentation build compiles
# no C++ and needs no C++ toolchain. Dev only: it raises the version stardoc
# would otherwise pick.
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)

# Bazel's Java launcher (used by stardoc) asks for a C++ toolchain even when
# nothing compiles C++, and .bazelrc turns off host toolchain detection. zig's
# toolchain is one self-contained binary, so it reads nothing from the host.
# Dev only: a user of the module brings its own C++ toolchain if it needs one.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    dev_dependency = True,
)

bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
