load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//em/private:toolchains.bzl", "helpers_toolchain", "tool_toolchain", "unsupported_platform_toolchain")

# --@hdlf_rules_em//em/toolchains:use_stub swaps every tool for the stub.
# swap_test sets it with a transition. A tool toolchain honors it by
# carrying target_settings = [":stub_off"], and its stub twin
# target_settings = [":stub_on"].
bool_flag(
    name = "use_stub",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_on",
    flag_values = {":use_stub": "true"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stub_off",
    flag_values = {":use_stub": "false"},
    visibility = ["//visibility:public"],
)

helpers_toolchain(
    name = "helpers_impl",
    compare = "//em/private/detcompare",
    launcher = "//em/private/launcher",
    swapcheck = "//em/private/swapcheck",
)

# The helpers run on Linux x86_64 only in v1 (spec P1). The outputs of the
# rules are files for any platform, so the target platform is not
# constrained here; the toolchain below fails analysis on other hosts.
toolchain(
    name = "helpers",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":helpers_impl",
    toolchain_type = "//em:helpers_toolchain_type",
)

# Any other execution platform: Bazel tries toolchains in the order they
# are registered, and MODULE.bazel registers this one last, so it is
# picked only where the one above does not match. Its analysis fails with
# a message that says which platform is supported (spec P1).
unsupported_platform_toolchain(
    name = "unsupported_impl",
    tags = ["manual"],
    visibility = ["//tests:__subpackages__"],
)

toolchain(
    name = "unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//em:helpers_toolchain_type",
)

# The openEMS toolchain (issue #1): openEMS d686f1d and CSXCAD 626b99f, as
# wheels built once and mirrored (tools/openems_wheels, tools/mirror), on
# CPython 3.12. Rules run its runner by the tool name "openems".
tool_toolchain(
    name = "openems_impl",
    tools = {"//em/private/runner": "openems"},
)

# Its swap_test twin: the stub in place of the runner.
tool_toolchain(
    name = "openems_stub_impl",
    tools = {"//em/private/stub": "openems"},
)

toolchain(
    name = "openems",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_off"],
    toolchain = ":openems_impl",
    toolchain_type = "//em:toolchain_type",
)

toolchain(
    name = "openems_stub",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":stub_on"],
    toolchain = ":openems_stub_impl",
    toolchain_type = "//em:toolchain_type",
)

# Off Linux x86_64, the same message as the helpers' (spec P1), rather
# than a toolchain resolution error. MODULE.bazel registers it last.
toolchain(
    name = "openems_unsupported",
    toolchain = ":unsupported_impl",
    toolchain_type = "//em:toolchain_type",
)
