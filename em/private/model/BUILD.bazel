load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

#
# The openEMS runner's scripts (issue #1): csx.py, kicad_em_model's
# model.json to model.xml, which solves nothing; sim.py, kicad_em_sim's
# solver runs; and geometry.py, the CSXCAD geometry both build.
exports_files(
    [
        "csx.py",
        "geometry.py",
        "sim.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "sim_lib",
    srcs = [
        "geometry.py",
        "sim.py",
    ],
    imports = ["."],
)

py_test(
    name = "sim_test",
    size = "small",
    srcs = ["sim_test.py"],
    config_settings = {
        "@rules_python//python/config_settings:bootstrap_impl": "script",
    },
    python_version = "3.12",
    deps = [
        ":sim_lib",
        "@em_pip//csxcad",
        "@em_pip//matplotlib",
        "@em_pip//numpy",
    ],
)
