load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# kicad_em_test's checker (issue #1, step 4): a kicad_em_sim's
# S-parameters against limits. Pure Go.
go_library(
    name = "emcheck",
    srcs = [
        "check.go",
        "signal.go",
        "touchstone.go",
    ],
    importpath = "github.com/filmil/bazel_rules_em/em/private/emcheck",
    visibility = ["//visibility:private"],
)

go_test(
    name = "emcheck_test",
    size = "small",
    srcs = ["emcheck_test.go"],
    embed = [":emcheck"],
    pure = "on",
)

go_binary(
    name = "cmd",
    srcs = ["cmd/main.go"],
    pure = "on",
    visibility = ["//em/toolchains:__pkg__"],
    deps = [":emcheck"],
)
